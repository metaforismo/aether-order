{
  "name": "@axiom-games/aether-order",
  "version": "0.1.0",
  "private": true,
  "description": "AETHER ORDER \u2014 a premium permutation draw built on Reveal Engine. Specification, exact enumeration and proofs.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "enumerate": "node tools/enumerate.mjs",
    "enumerate:json": "node tools/enumerate.mjs --json",
    "enumerate:markdown": "node tools/enumerate.mjs --markdown",
    "enumerate:write": "node tools/enumerate.mjs --write",
    "enumerate:montecarlo": "node tools/enumerate.mjs --monte-carlo=200000",
    "bench": "node tools/bench.mjs",
    "dev": "node --import tsx src/server/main.ts",
    "build": "node --import tsx -e \"import('./src/server/build-client.ts').then((m) => m.buildClient())\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && vitest run --config vitest.bench.config.ts",
    "test:watch": "vitest",
    "verify": "npm run enumerate && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@axiom-games/reveal-engine": "file:vendor/axiom-games-reveal-engine-0.4.0.tgz"
  }
}
